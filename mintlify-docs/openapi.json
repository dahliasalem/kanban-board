{
  "openapi": "3.1.0",
  "info": {
    "title": "Kanban Board API",
    "description": "Next.js API routes that proxy third-party calls requiring a secret key. Currently one planned route: Unsplash background search (PRD §5.5).",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "http://localhost:3000/api" }
  ],
  "paths": {
    "/unsplash/search": {
      "get": {
        "summary": "Search Unsplash for board background images",
        "description": "Proxies a search request to the Unsplash API server-side, so `UNSPLASH_ACCESS_KEY` is never exposed to the client. Status: planned, not yet implemented — see the Roadmap.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search term, e.g. \"mountains\" or \"minimal desk\".",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for paginated results.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of matching Unsplash photos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "Unsplash photo ID." },
                          "url": { "type": "string", "format": "uri" },
                          "photographerName": { "type": "string" },
                          "photographerUrl": { "type": "string", "format": "uri" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "id": "abc123",
                      "url": "https://images.unsplash.com/photo-abc123",
                      "photographerName": "Jane Doe",
                      "photographerUrl": "https://unsplash.com/@janedoe"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid `query` parameter."
          },
          "502": {
            "description": "The Unsplash API request failed."
          }
        }
      }
    }
  }
}
